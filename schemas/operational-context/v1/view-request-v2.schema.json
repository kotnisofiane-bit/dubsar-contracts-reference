    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "oneOf": [
          {
            "$ref": "https://contracts.dubsar.invalid/operational-context/v1/resource.schema.json"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "local_ref"
            ],
            "properties": {
              "local_ref": {
                "$ref": "https://contracts.dubsar.invalid/operational-context/v1/common.schema.json#/$defs/token"
              }
            }
          }
        ]
      }
    },
    "properties": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "https://contracts.dubsar.invalid/operational-context/v1/common.schema.json#/$defs/token"
