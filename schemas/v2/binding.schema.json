{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.dev/schemas/v2/binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "tenant_ref",
    "mission",
    "legacy_refs",
    "project_ref",
    "run_id",
    "step_id",
    "proposal_id",
    "workload_identity"
  ],
  "properties": {
    "schema": {
      "const": "dubsar.mission-binding.v2"
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "id"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "legacy_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "namespace",
          "id"
        ],
        "properties": {
          "namespace": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "project_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "step_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "proposal_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "workload_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "instance_id"
      ],
      "properties": {
        "workload_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "instance_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    }
  }
}
