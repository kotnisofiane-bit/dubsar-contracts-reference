{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.dev/schemas/v2/receipt.schema.json",
  "title": "DUBSAR exact action receipt v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "contract_version",
    "receipt_id",
    "proposal_id",
    "run_id",
    "step_id",
    "workflow_digest",
    "action",
    "broker_identity",
    "core_decision",
    "capability_jti",
    "before_state",
    "after_state",
    "result",
    "recorded_at",
    "evidence_chain",
    "exact_action",
    "business_outcome"
  ],
  "properties": {
    "schema": {
      "const": "dubsar.action-receipt.v2"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^receipt_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^step_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "workflow_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "connector",
        "operation"
      ],
      "properties": {
        "kind": {
          "const": "connector_action"
        },
        "connector": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "version"
          ],
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._/-]{1,127}$"
            },
            "version": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
            }
          }
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        }
      }
    },
    "broker_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "instance_id"
      ],
      "properties": {
        "workload_id": {
          "type": "string",
          "pattern": "^workload_[a-z0-9][a-z0-9_-]{7,127}$"
        },
        "instance_id": {
          "type": "string",
          "pattern": "^instance_[a-z0-9][a-z0-9_-]{7,127}$"
        }
      }
    },
    "core_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "approval_id",
        "policy_digest"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^decision_[a-z0-9][a-z0-9_-]{7,127}$"
        },
        "approval_id": {
          "type": "string",
          "pattern": "^approval_[a-z0-9][a-z0-9_-]{7,127}$"
        },
        "policy_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "capability_jti": {
      "type": "string",
      "pattern": "^jti_[A-Za-z0-9_-]{32,128}$"
    },
    "before_state": {
      "enum": [
        "AUTHORIZED",
        "DENIED",
        "EXPIRED",
        "FAILED_FINAL",
        "FAILED_RETRYABLE",
        "HUMAN_DECISION_REQUIRED",
        "INDETERMINATE",
        "IN_FLIGHT",
        "RECEIVED",
        "RECONCILED_FAILED",
        "RECONCILED_SUCCEEDED",
        "SUCCEEDED"
      ]
    },
    "after_state": {
      "enum": [
        "AUTHORIZED",
        "DENIED",
        "EXPIRED",
        "FAILED_FINAL",
        "FAILED_RETRYABLE",
        "HUMAN_DECISION_REQUIRED",
        "INDETERMINATE",
        "IN_FLIGHT",
        "RECEIVED",
        "RECONCILED_FAILED",
        "RECONCILED_SUCCEEDED",
        "SUCCEEDED"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "outcome_digest",
            "provider_status"
          ],
          "properties": {
            "kind": {
              "const": "success"
            },
            "outcome_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            "provider_status": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "error"
          ],
          "properties": {
            "kind": {
              "const": "error"
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "code",
                "category",
                "retryable",
                "detail_digest"
              ],
              "properties": {
                "code": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
                },
                "category": {
                  "enum": [
                    "AUTHORIZATION",
                    "CONFLICT",
                    "PROVIDER",
                    "RATE_LIMIT",
                    "TIMEOUT",
                    "TRANSPORT",
                    "VALIDATION"
                  ]
                },
                "retryable": {
                  "type": "boolean"
                },
                "detail_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                }
              }
            }
          }
        }
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "evidence_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "previous_event_digest",
        "event_digest"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "pattern": "^event_[a-z0-9][a-z0-9_-]{7,127}$"
        },
        "previous_event_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "event_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "exact_action": {
      "$ref": "./proof.schema.json"
    },
    "business_outcome": {
      "const": "UNOBSERVED"
    }
  },
  "$defs": {
    "successResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outcome_digest",
        "provider_status"
      ],
      "properties": {
        "kind": {
          "const": "success"
        },
        "outcome_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "provider_status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        }
      }
    },
    "errorResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "error"
      ],
      "properties": {
        "kind": {
          "const": "error"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "category",
            "retryable",
            "detail_digest"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
            },
            "category": {
              "enum": [
                "AUTHORIZATION",
                "CONFLICT",
                "PROVIDER",
                "RATE_LIMIT",
                "TIMEOUT",
                "TRANSPORT",
                "VALIDATION"
              ]
            },
            "retryable": {
              "type": "boolean"
            },
            "detail_digest": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      }
    }
  }
}
