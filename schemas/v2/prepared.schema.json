{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.dev/schemas/v2/prepared.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "binding_digest",
    "proposal_digest",
    "approval_digest",
    "artifact",
    "material",
    "display",
    "expected_effect",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "dubsar.prepared-action.v2"
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "proposal_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "approval_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "material": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adapter_digest",
        "configuration_digest",
        "configuration"
      ],
      "properties": {
        "adapter_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "configuration_digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "configuration": {
          "type": "object",
          "description": "Complete resolved material configuration; no mutable defaults may be read at execution."
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "expected_effect": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
