{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.dev/schemas/v2/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_ref",
    "binding_digest",
    "prepared_digest",
    "display_digest",
    "approver",
    "policy_digest",
    "decision",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "dubsar.exact-decision.v2"
    },
    "decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "binding_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "prepared_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "display_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "approver": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject",
        "active_function"
      ],
      "properties": {
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "active_function": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "policy_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decision": {
      "enum": [
        "APPROVE",
        "REFUSE"
      ]
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
