{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.local/document-access/v1/request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "proof",
    "context",
    "request_ref",
    "requested_resources"
  ],
  "properties": {
    "proof": {
      "type": "object"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tenant_ref",
        "context_ref"
      ],
      "properties": {
        "tenant_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f*]+$"
        },
        "context_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f*]+$"
        }
      }
    },
    "request_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "requested_resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corpus_ref",
          "document_ref"
        ],
        "properties": {
          "corpus_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f*]+$"
          },
          "document_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f*]+$"
          }
        }
      }
    }
  }
}
