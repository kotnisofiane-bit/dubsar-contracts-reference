{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.local/document-access/v1/decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "decision_id",
    "subject_ref",
    "tenant_ref",
    "active_function",
    "session_ref",
    "request_ref",
    "resources",
    "policy_epoch",
    "issued_at",
    "expires_at",
    "scope_digest"
  ],
  "properties": {
    "schema": {
      "const": "dubsar.document-decision/1"
    },
    "decision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "subject_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "active_function": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "session_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "request_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001f*]+$"
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "corpus_ref",
          "document_ref",
          "resource_version"
        ],
        "properties": {
          "corpus_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f*]+$"
          },
          "document_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f*]+$"
          },
          "resource_version": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "pattern": "^[^\\u0000-\\u001f*]+$"
          }
        }
      }
    },
    "policy_epoch": {
      "type": "string",
      "pattern": "^[1-9][0-9]*$"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "scope_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  }
}
