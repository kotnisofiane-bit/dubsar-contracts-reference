{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dubsar.dev/schemas/artifacts/v1/artifact-ref.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_id",
    "tenant_id",
    "corpus_id",
    "mission_id",
    "artifact_type",
    "media_type",
    "size_bytes",
    "digest",
    "location",
    "producer",
    "origin",
    "classification",
    "created_at",
    "published_at",
    "expires_at",
    "retention_policy",
    "deletion_state",
    "deleted_at",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": {
      "const": "dubsar.artifact-ref/1"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^artifact:[a-f0-9-]{36}$"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "corpus_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "mission_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    },
    "artifact_type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9.-]{1,127}$"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1048576
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "location": {
      "type": "string",
      "pattern": "^blob:[a-f0-9-]{36}$"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "contract_version"
      ],
      "properties": {
        "component": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "contract_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "parent_artifact_ids"
      ],
      "properties": {
        "source_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "parent_artifact_ids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^artifact:[a-f0-9-]{36}$"
          }
        }
      }
    },
    "classification": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "published_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "retention_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_id",
        "hold"
      ],
      "properties": {
        "policy_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "hold": {
          "type": "boolean"
        }
      }
    },
    "deletion_state": {
      "enum": [
        "ACTIVE",
        "DELETE_REQUESTED",
        "TOMBSTONED",
        "PURGED",
        "QUARANTINED",
        "INDETERMINATE"
      ]
    },
    "deleted_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
