            "new_element_ids",
            "limit_ids"
          ],
          "properties": {
            "previous_response_ref": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "change": {
              "enum": [
                "strengthened",
                "weakened",
                "contradiction_identified",
                "conflict_resolved",
                "withdrawn"
              ]
            },
            "status": {
              "$ref": "common.schema.json#/$defs/status"
            },
            "claim_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "maxItems": 8,
              "minItems": 1,
              "uniqueItems": true
            },
            "element_ids": {
              "$ref": "common.schema.json#/$defs/ids"
            },
            "new_element_ids": {
              "type": "array",
              "items": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "maxItems": 32,
              "minItems": 1,
              "uniqueItems": true
            },
            "limit_ids": {
              "$ref": "common.schema.json#/$defs/ids"
            }
          }
        },
        "advisory": {
          "$ref": "common.schema.json#/$defs/advisory"
        }
      }
    },
    {
      "type": "object",
