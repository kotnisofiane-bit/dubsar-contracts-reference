      ],
      "properties": {
        "format": {
          "const": "dubsar.judgment.output/1"
        },
        "authority": {
          "const": "none"
        },
        "content_trust": {
          "const": "advisory_data"
        },
        "text_role": {
          "const": "data"
        },
        "truth": {
          "const": "not_selected"
        },
        "executable": {
          "const": false
        },
        "move": {
          "const": "clarify"
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "missing_ids",
            "limit_ids"
