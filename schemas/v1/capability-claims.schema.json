{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dubsar.invalid/v1/capability-claims.schema.json",
  "title": "DUBSAR Action Capability Claims v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "jti", "issuer", "audience", "subject_workload_id", "run_id", "step_id", "workflow_id", "workflow_digest", "approval_id", "proposal_id", "action", "connection_ref", "payload_digest", "destinations", "bounds", "issued_at", "not_before", "expires_at", "revoked_at"],
  "properties": {
    "schema": {
      "const": "dubsar.capability-claims.v1"
    },
    "contract_version": {
      "$ref": "./common.schema.json#/$defs/contractVersion"
    },
    "jti": {
      "type": "string",
      "pattern": "^jti_[A-Za-z0-9_-]{32,128}$"
    },
    "issuer": {
      "const": "dubsar-governance-core"
    },
    "audience": {
      "const": "dubsar-action-broker"
    },
    "subject_workload_id": {
      "type": "string",
      "pattern": "^workload_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^run_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^step_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "workflow_digest": {
      "$ref": "./common.schema.json#/$defs/digest"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^approval_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^proposal_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "action": {
      "$ref": "./common.schema.json#/$defs/actionIdentity"
    },
    "connection_ref": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/connectionRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "payload_digest": {
      "$ref": "./common.schema.json#/$defs/digest"
    },
    "destinations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "$ref": "./common.schema.json#/$defs/destination"
      }
    },
    "bounds": {
      "$ref": "./common.schema.json#/$defs/policyBounds"
    },
    "issued_at": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "not_before": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "./common.schema.json#/$defs/timestamp"
    },
    "revoked_at": {
      "oneOf": [
        {
          "$ref": "./common.schema.json#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
