{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.dubsar.invalid/v1/workflow-ir.schema.json",
  "title": "DUBSAR Workflow IR v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract_version", "workflow_id", "workflow_version", "name", "entry_node_id", "nodes", "transitions"],
  "properties": {
    "schema": {
      "const": "dubsar.workflow-ir.v1"
    },
    "contract_version": {
      "$ref": "./common.schema.json#/$defs/contractVersion"
    },
    "workflow_id": {
      "type": "string",
      "pattern": "^wf_[a-z0-9][a-z0-9_-]{7,127}$"
    },
    "workflow_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2147483647
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "entry_node_id": {
      "type": "string",
      "pattern": "^node_[a-z0-9][a-z0-9_-]{3,127}$"
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "transitions": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "$ref": "#/$defs/transition"
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "order", "kind", "connector", "operation", "connection_ref", "parameters", "templates", "policy_bounds"],
      "properties": {
        "node_id": {
          "type": "string",
          "pattern": "^node_[a-z0-9][a-z0-9_-]{3,127}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1023
        },
        "kind": {
          "enum": ["action", "trigger"]
        },
        "connector": {
          "$ref": "./common.schema.json#/$defs/connector"
        },
        "operation": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]{1,127}$"
        },
        "connection_ref": {
          "oneOf": [
            {
              "$ref": "./common.schema.json#/$defs/connectionRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "parameters": {
          "$ref": "./common.schema.json#/$defs/jsonValue"
        },
        "templates": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/template"
          }
        },
        "policy_bounds": {
          "$ref": "./common.schema.json#/$defs/policyBounds"
        }
      }
    },
    "template": {
      "type": "object",
      "additionalProperties": false,
      "required": ["template_id", "language", "expression"],
      "properties": {
        "template_id": {
          "type": "string",
          "pattern": "^tpl_[a-z0-9][a-z0-9_-]{3,127}$"
        },
        "language": {
          "const": "dubsar-template-v1"
        },
        "expression": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transition_id", "order", "from_node_id", "to_node_id", "condition"],
      "properties": {
        "transition_id": {
          "type": "string",
          "pattern": "^edge_[a-z0-9][a-z0-9_-]{3,127}$"
        },
        "order": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4095
        },
        "from_node_id": {
          "type": "string",
          "pattern": "^node_[a-z0-9][a-z0-9_-]{3,127}$"
        },
        "to_node_id": {
          "type": "string",
          "pattern": "^node_[a-z0-9][a-z0-9_-]{3,127}$"
        },
        "condition": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "template_ref"],
          "properties": {
            "kind": {
              "enum": ["always", "template"]
            },
            "template_ref": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^tpl_[a-z0-9][a-z0-9_-]{3,127}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  }
}
