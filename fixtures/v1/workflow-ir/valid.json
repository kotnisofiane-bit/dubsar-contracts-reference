{
  "schema": "dubsar.workflow-ir.v1",
  "contract_version": "1.0.0",
  "workflow_id": "wf_ticketpilot_001",
  "workflow_version": 1,
  "name": "Create a bounded ticket",
  "entry_node_id": "node_manual_start",
  "nodes": [
    {
      "node_id": "node_manual_start",
      "order": 0,
      "kind": "trigger",
      "connector": {
        "name": "dubsar.manual",
        "version": "1.0.0"
      },
      "operation": "manual_start",
      "connection_ref": null,
      "parameters": {},
      "templates": [],
      "policy_bounds": {
        "timeout_ms": 1000,
        "max_attempts": 1,
        "max_payload_bytes": 0,
        "allowed_destinations": []
      }
    },
    {
      "node_id": "node_create_ticket",
      "order": 1,
      "kind": "action",
      "connector": {
        "name": "dubsar.ticketing",
        "version": "1.2.3"
      },
      "operation": "create_ticket",
      "connection_ref": "conn_ticketing_demo",
      "parameters": {
        "priority": "normal"
      },
      "templates": [
        {
          "template_id": "tpl_ticket_summary",
          "language": "dubsar-template-v1",
          "expression": "{{trigger.subject}}"
        }
      ],
      "policy_bounds": {
        "timeout_ms": 5000,
        "max_attempts": 1,
        "max_payload_bytes": 4096,
        "allowed_destinations": [
          {
            "scheme": "https",
            "host": "tickets.example.invalid",
            "port": 443,
            "path_prefix": "/api/v1/tickets",
            "methods": ["POST"]
          }
        ]
      }
    }
  ],
  "transitions": [
    {
      "transition_id": "edge_manual_to_ticket",
      "order": 0,
      "from_node_id": "node_manual_start",
      "to_node_id": "node_create_ticket",
      "condition": {
        "kind": "always",
        "template_ref": null
      }
    }
  ]
}
